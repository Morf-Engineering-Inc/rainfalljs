{
  "name": "@morf_engineering/rainfalljs",
  "version": "0.3.2",
  "description": "Compact, validated data-layer manifests for token-efficient AI development \u2014 entities, endpoints, components and the requirements they serve, in one file your build can check.",
  "main": "dist/datamap/index.js",
  "files": [
    "dist",
    "bin",
    "cli",
    "scripts",
    "schema",
    "skills",
    "examples/manifest",
    "README.md",
    "docs/DATA-MAP.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/gen-components.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build && jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "ai-agents",
    "context",
    "tokens",
    "manifest",
    "data-map",
    "api-contract",
    "access-patterns",
    "requirements-traceability",
    "documentation",
    "codegen"
  ],
  "author": "Morf Engineering Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morf-Engineering-Inc/rainfalljs.git"
  },
  "homepage": "https://github.com/Morf-Engineering-Inc/rainfalljs",
  "bugs": {
    "url": "https://github.com/Morf-Engineering-Inc/rainfalljs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/datamap/index.d.ts",
      "require": "./dist/datamap/index.js",
      "import": "./dist/datamap/index.js"
    },
    "./datamap": {
      "types": "./dist/datamap/index.d.ts",
      "require": "./dist/datamap/index.js",
      "import": "./dist/datamap/index.js"
    },
    "./schema": "./schema/rainfall.schema.json",
    "./package.json": "./package.json",
    "./mapper": {
      "types": "./dist/mapper/index.d.ts",
      "require": "./dist/mapper/index.js",
      "import": "./dist/mapper/index.js"
    }
  },
  "bin": {
    "rainfall": "./bin/rainfall.js"
  },
  "types": "dist/datamap/index.d.ts"
}
