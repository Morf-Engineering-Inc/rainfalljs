{
  "name": "@morf_engineering/rainfalljs",
  "version": "0.2.0",
  "description": "The Data Map: one declaration of how data flows from business requirement to endpoint to screen \u2014 plus a React/Next data provider.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist",
    "README.md",
    "docs/DATA-MAP.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:datamap",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir dist --extensions '.js,.jsx'",
    "build:esm": "cross-env BABEL_ENV=esm babel src --out-dir dist/esm --extensions '.js,.jsx'",
    "prepublishOnly": "npm run build",
    "test": "npm run build && jest",
    "build:datamap": "tsc -p tsconfig.datamap.json",
    "typecheck": "tsc -p tsconfig.datamap.json --noEmit"
  },
  "keywords": [
    "react",
    "nextjs",
    "data",
    "provider",
    "context",
    "data-map",
    "api-contract",
    "access-patterns",
    "requirements-traceability",
    "documentation",
    "llm",
    "ai-agents"
  ],
  "author": "Morf Engineering Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Morf-Engineering-Inc/rainfalljs"
  },
  "homepage": "https://github.com/Morf-Engineering-Inc/rainfalljs",
  "bugs": {
    "url": "https://github.com/Morf-Engineering-Inc/rainfalljs/issues"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.9",
    "@babel/plugin-transform-runtime": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/runtime": "^7.26.9",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@testing-library/react": "^16.2.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "microbundle": "^0.15.1",
    "react-test-renderer": "^19.0.0",
    "rimraf": "^6.0.1",
    "rollup": "^2.79.2",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "^4.9.5"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./next": {
      "require": "./dist/next/next-data-provider.js",
      "import": "./dist/esm/next/next-data-provider.js"
    },
    "./datamap": {
      "types": "./dist/datamap/index.d.ts",
      "require": "./dist/datamap/index.js",
      "import": "./dist/datamap/index.js"
    },
    "./package.json": "./package.json"
  }
}
